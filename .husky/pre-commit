. "$(dirname "$0")/_/husky.sh"

echo "🛡️  CODE GUARDIAN ACTIVATED..."

# 1. Check Python Backend
echo "🐍 Checking: backend..."
cd backend
if [ -f ".venv/Scripts/black" ]; then
    ./.venv/Scripts/black --check . || exit 1
    ./.venv/Scripts/flake8 . || exit 1
else
    # Fallback for Linux/Mac or global python
    python -m black --check . || exit 1
    python -m flake8 . || exit 1
fi
cd ..

# 2. Check Log Service
echo "📊 Checking: log-service..."
cd log
npm run lint || exit 1
cd ..

# 3. Check API Gateway
echo "🚪 Checking: api-gateway..."
cd api-gateway
npm run lint || exit 1
cd ..

echo "✅ ALL CLEAN! COMMIT AUTHORIZED."