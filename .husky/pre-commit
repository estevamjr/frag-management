#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🛡️  GUARDIÃO DO CÓDIGO ATIVADO..."

# 1. Verificar Backend Python
echo "🐍 Verificando: backend..."
cd backend
if [ -f ".venv/Scripts/black" ]; then
    ./.venv/Scripts/black --check . || exit 1
    ./.venv/Scripts/flake8 . || exit 1
else
    python -m black --check . || exit 1
    python -m flake8 . || exit 1
fi
cd ..

# 2. Verificar Log API
echo "📊 Verificando: log..."
cd log
npm run lint || exit 1
cd ..

# 3. Verificar API Gateway
echo "🚪 Verificando: api-gateway..."
cd api-gateway
npm run lint || exit 1
cd ..

echo "✅ TUDO LIMPO! COMMIT AUTORIZADO."